{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Provider Gateway for Claude",
  "mainBinaryName": "provider-gateway",
  "version": "0.1.0",
  "identifier": "app.provider-gateway-for-claude",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Provider Gateway for Claude",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3RjY1QzI4NkU1MTg3MDAKUldRQWgxRnVLRnoySjVuYTBoVkM2RmZUVHNXNS9ZemtKMThLWW9pcVNOWnM1Q0xQWnZBdis5T2UK",
      "endpoints": [
        "https://github.com/d-ridelman/provider-gateway-for-claude/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "resources": {
      "../../LICENSE-MIT": "LICENSE-MIT.txt",
      "../../LICENSE-APACHE": "LICENSE-APACHE.txt",
      "../../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "publisher": "Provider Gateway for Claude contributors",
    "copyright": "Provider Gateway for Claude contributors. MIT OR Apache-2.0.",
    "shortDescription": "Local Anthropic Messages gateway for Claude Desktop and Claude Code",
    "longDescription": "Runs Claude Desktop (third-party inference mode) and Claude Code through any OpenAI- or Anthropic-compatible provider via a local gateway. Not affiliated with Anthropic.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian"]
      }
    }
  }
}
